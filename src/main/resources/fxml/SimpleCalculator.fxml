<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets ?>
<?import javafx.geometry.Pos ?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gustavo.calculator.controller.CalculatorController">

    <center>
        <VBox spacing="15" alignment="CENTER">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!--DISPLAY-->
            <VBox spacing="5" fx:id="displayContainer">

                 <Label fx:id="expressionLabel" text="" />

                 <Label fx:id="resultLabel" text="0"/>

            </VBox>


            <!-- MODE SWITCH -->

            <ToggleButton text="Científica"/>

            <GridPane hgap="10">

                <Button text="AC"
                        GridPane.columnIndex="0"
                        GridPane.rowIndex="0"/>

                <Button text="⌫"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="0"/>

                <Button text="×"
                        GridPane.columnIndex="2"
                        GridPane.rowIndex="0"/>
            </GridPane>



            <!-- BUTTONS -->
            <GridPane hgap="10"
                      vgap="10"
                      alignment="CENTER">

                <!-- LINHA 1 -->

                <Button text="7"
                        prefHeight="65"
                        prefWidth="65"
                        GridPane.rowIndex="0"
                        GridPane.columnIndex="0"/>

                <Button text="8"
                        prefHeight="65"
                        prefWidth="65"
                        GridPane.rowIndex="0"
                        GridPane.columnIndex="1"/>

                <Button text="9"
                        prefHeight="65"
                        prefWidth="65"
                        GridPane.rowIndex="0"
                        GridPane.columnIndex="2"/>

                <Button text="+"
                        prefHeight="65"
                        prefWidth="65"
                        GridPane.rowIndex="0"
                        GridPane.columnIndex="3"/>


                <!-- LINHA 2 -->
                <Button text="4"
                        prefHeight="65"
                        prefWidth="65"
                        GridPane.rowIndex="1"
                        GridPane.columnIndex="0"/>

                <Button text="5"
                        prefHeight="65"
                        prefWidth="65"
                        GridPane.rowIndex="1"
                        GridPane.columnIndex="1"/>

                <Button text="6"
                        prefHeight="65"
                        prefWidth="65"
                        GridPane.rowIndex="1"
                        GridPane.columnIndex="2"/>

                <Button text="-"
                        prefHeight="65"
                        prefWidth="65"
                        GridPane.rowIndex="1"
                        GridPane.columnIndex="3"/>

                <!-- LINHA 3 -->
                <Button text="1"
                        prefHeight="65"
                        prefWidth="65"
                        GridPane.rowIndex="2"
                        GridPane.columnIndex="0"/>

                <Button text="2"
                        prefHeight="65"
                        prefWidth="65"
                        GridPane.rowIndex="2"
                        GridPane.columnIndex="1"/>

                <Button text="3"
                        prefHeight="65"
                        prefWidth="65"
                        GridPane.rowIndex="2"
                        GridPane.columnIndex="2"/>

                <Button text="÷"
                        prefHeight="65"
                        prefWidth="65"
                        GridPane.rowIndex="2"
                        GridPane.columnIndex="3"/>

                <!-- LINHA 4 -->
                <Button text="0"
                        prefHeight="65"
                        prefWidth="140"
                        GridPane.rowIndex="3"
                        GridPane.columnIndex="0"
                        GridPane.columnSpan="2"/>

                <Button text="."
                        prefHeight="65"
                        prefWidth="65"
                        GridPane.rowIndex="3"
                        GridPane.columnIndex="2"/>

                <Button text="="
                        prefHeight="65"
                        prefWidth="65"
                        GridPane.rowIndex="3"
                        GridPane.columnIndex="3"/>


            </GridPane>

        </VBox>

    </center>
</BorderPane>